{
  "name": "mina-voice-studio",
  "version": "1.0.0",
  "private": true,
  "main": "main.cjs",
  "description": "Estudio local de generación de voz por referencia de audio",
  "author": "XDAVIXD",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "node build-icon.mjs && electron-builder --win nsis portable"
  },
  "dependencies": { "fflate": "^0.8.2" },
  "devDependencies": { "electron": "^44.0.0", "electron-builder": "^26.15.3", "png-to-ico": "^3.0.2", "ffmpeg-static": "^5.3.0" },
  "build": {
    "appId": "com.xdavixd.minavoicestudio",
    "productName": "MINA Voice Studio",
    "asar": true,
    "files": ["main.cjs", "backend.cjs", "setup.cjs", "preload.cjs", "renderer.js", "index.html", "styles.css", "assets/**/*", "node_modules/fflate/**/*"],
    "extraResources": [
      { "from": "engine", "to": "engine" },
      { "from": "node_modules/ffmpeg-static/ffmpeg.exe", "to": "ffmpeg.exe" }
      ,{ "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE", "to": "licenses/ffmpeg-LICENSE.txt" }
      ,{ "from": "node_modules/ffmpeg-static/ffmpeg.exe.README", "to": "licenses/ffmpeg-README.txt" }
    ],
    "directories": { "output": "release", "buildResources": "build" },
    "win": { "icon": "build/icon.ico", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "MINA Voice Studio",
      "installerIcon": "build/icon.ico", "uninstallerIcon": "build/icon.ico", "artifactName": "Instalador-MINA-Voice-Studio-${version}.${ext}" },
    "portable": { "artifactName": "MINA-Voice-Studio-Portable-${version}.${ext}" }
  }
}
